<%
  const galleryImages = (car.images && car.images.length)
    ? car.images
    : (car.image && car.image !== '' ? [car.image] : []);
  const isOwner = currentUser && car.owner && car.owner.toString() === currentUser._id.toString();
  const avgRating = car.reviews && car.reviews.length
    ? (car.reviews.reduce((s,r)=>s+r.rating,0)/car.reviews.length).toFixed(1)
    : null;
%>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

<!-- Flash Messages -->
<% if (typeof success !== 'undefined' && success && success.length) { %>
<div class="sp-flash sp-flash-ok"><i class="bi bi-check-circle-fill"></i> <%= success %><button onclick="this.parentElement.remove()" class="sp-flash-x">&times;</button></div>
<% } %>
<% if (typeof error !== 'undefined' && error && error.length) { %>
<div class="sp-flash sp-flash-err"><i class="bi bi-exclamation-triangle-fill"></i> <%= error %><button onclick="this.parentElement.remove()" class="sp-flash-x">&times;</button></div>
<% } %>

<div class="sp-wrap">
  <!-- Breadcrumb -->
  <nav class="sp-crumbs">
    <a href="/"><i class="bi bi-house"></i></a>
    <span>›</span>
    <a href="/cars">All Cars</a>
    <span>›</span>
    <span class="sp-crumb-cur"><%= car.carName %></span>
  </nav>

  <!-- ══ TOP GRID: Gallery + Panel ══ -->
  <div class="sp-top">

    <!-- GALLERY -->
    <div class="sp-gallery">
      <div class="sp-gallery-main" id="spGalleryMain">
        <% if(galleryImages.length === 0){ %>
          <div class="sp-no-img"><i class="bi bi-image"></i><span>No photos yet</span></div>
        <% } else { %>
          <% galleryImages.forEach(function(img,i){ %>
            <img src="<%= img %>" alt="<%= car.carName %> photo <%= i+1 %>"
              class="sp-img<%= i===0?' sp-img-active':'' %>" data-idx="<%= i %>" />
          <% }); %>
        <% } %>

        <div class="sp-gallery-badges">
          <span class="sp-badge sp-badge-sale">For Sale</span>
          <% if(car.urgentSale){ %><span class="sp-badge sp-badge-urgent"><i class="bi bi-lightning-charge-fill"></i> Urgent</span><% } %>
          <% if(car.year){ %><span class="sp-badge sp-badge-year"><%= car.year %></span><% } %>
        </div>

        <% if(galleryImages.length > 1){ %>
          <span class="sp-counter" id="spCounter">1 / <%= galleryImages.length %></span>
          <button class="sp-nav sp-nav-l" id="spPrev"><i class="bi bi-chevron-left"></i></button>
          <button class="sp-nav sp-nav-r" id="spNext"><i class="bi bi-chevron-right"></i></button>
        <% } %>
      </div>

      <% if(galleryImages.length > 1){ %>
      <div class="sp-thumbs" id="spThumbs">
        <% galleryImages.forEach(function(img,i){ %>
          <button class="sp-thumb<%= i===0?' sp-thumb-active':'' %>" data-thumb="<%= i %>">
            <img src="<%= img %>" alt="Thumb <%= i+1 %>" loading="lazy" />
          </button>
        <% }); %>
      </div>
      <% } %>
    </div>

    <!-- INFO PANEL -->
    <div class="sp-panel">

      <!-- Price card -->
      <div class="sp-price-card">
        <div class="sp-price-header">
          <div>
            <div class="sp-listed-tag">Used Vehicle</div>
            <h1 class="sp-car-name"><%= car.carName %></h1>
            <div class="sp-location"><i class="bi bi-geo-alt-fill"></i> <%= car.city %><% if(car.state){ %>, <%= car.state %><% } %></div>
          </div>
          <div class="sp-status">Active</div>
        </div>
        <div class="sp-divider"></div>
        <div class="sp-price-row">
          <div class="sp-price">
            <span class="sp-price-cur">₹</span><%= car.price ? car.price.toLocaleString('en-IN') : 'N/A' %>
          </div>
          <div class="sp-price-tags">
            <% if(car.negotiable){ %><span class="sp-ptag sp-ptag-green"><i class="bi bi-check2-circle"></i> Negotiable</span><% } %>
            <% if(car.sellerType){ %><span class="sp-ptag"><i class="bi bi-person-check"></i> <%= car.sellerType %></span><% } %>
          </div>
        </div>
      </div>

      <!-- Quick specs -->
      <div class="sp-card">
        <div class="sp-card-label"><i class="bi bi-sliders"></i> Specifications</div>
        <div class="sp-specs">
          <div class="sp-spec">
            <div class="sp-spec-ico" style="background:#eff6ff;color:#2563eb"><i class="bi bi-calendar-check"></i></div>
            <div><div class="sp-spec-lbl">Year</div><div class="sp-spec-val"><%= car.year||'—' %></div></div>
          </div>
          <div class="sp-spec">
            <div class="sp-spec-ico" style="background:#fff7ed;color:#ea580c"><i class="bi bi-fuel-pump"></i></div>
            <div><div class="sp-spec-lbl">Fuel</div><div class="sp-spec-val"><%= car.fuel||'—' %></div></div>
          </div>
          <div class="sp-spec">
            <div class="sp-spec-ico" style="background:#f5f3ff;color:#7c3aed"><i class="bi bi-gear-wide-connected"></i></div>
            <div><div class="sp-spec-lbl">Transmission</div><div class="sp-spec-val"><%= car.transmission||'—' %></div></div>
          </div>
          <div class="sp-spec">
            <div class="sp-spec-ico" style="background:#f0fdf4;color:#16a34a"><i class="bi bi-speedometer2"></i></div>
            <div><div class="sp-spec-lbl">KM Driven</div><div class="sp-spec-val"><%= car.mileage ? car.mileage.toLocaleString('en-IN')+' km' : '—' %></div></div>
          </div>
          <% if(car.ownership){ %>
          <div class="sp-spec">
            <div class="sp-spec-ico" style="background:#fefce8;color:#ca8a04"><i class="bi bi-person-badge"></i></div>
            <div><div class="sp-spec-lbl">Ownership</div><div class="sp-spec-val"><%= car.ownership %></div></div>
          </div>
          <% } %>
          <% if(car.color){ %>
          <div class="sp-spec">
            <div class="sp-spec-ico" style="background:#fdf2f8;color:#9d174d"><i class="bi bi-palette"></i></div>
            <div><div class="sp-spec-lbl">Color</div><div class="sp-spec-val"><%= car.color %></div></div>
          </div>
          <% } %>
        </div>
      </div>

      <!-- Seller -->
      <div class="sp-card">
        <div class="sp-card-label"><i class="bi bi-person-badge"></i> Seller</div>
        <div class="sp-seller">
          <div class="sp-seller-av"><%= car.dealerName ? car.dealerName.charAt(0).toUpperCase() : 'S' %></div>
          <div>
            <div class="sp-seller-name"><%= car.dealerName %></div>
            <div class="sp-seller-tag"><i class="bi bi-patch-check-fill"></i> Verified Seller</div>
          </div>
        </div>
        <div class="sp-cta">
          <a href="tel:<%= car.dealerPhone %>" class="sp-btn sp-btn-call"><i class="bi bi-telephone-fill"></i> Call Seller</a>
          <a href="https://wa.me/<%= car.dealerPhone.replace(/[^0-9]/g,'') %>?text=Hi%2C+I'm+interested+in+your+<%= encodeURIComponent(car.carName) %>+listed+on+RideHub." target="_blank" rel="noopener" class="sp-btn sp-btn-wa"><i class="bi bi-whatsapp"></i> WhatsApp</a>
        </div>
        <% if(isOwner){ %>
        <div class="sp-owner-strip">
          <div class="sp-owner-lbl"><i class="bi bi-shield-lock-fill"></i> You own this listing</div>
          <div class="sp-owner-actions">
            <a href="/cars/<%= car._id %>/edit" class="sp-owner-btn sp-owner-edit"><i class="bi bi-pencil-square"></i> Edit</a>
            <form action="/cars/<%= car._id %>?_method=DELETE" method="POST" style="flex:1" onsubmit="return spConfirmDelete()">
              <button type="submit" class="sp-owner-btn sp-owner-del" style="width:100%"><i class="bi bi-trash3"></i> Delete</button>
            </form>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- ══ BOTTOM: Full Details + Reviews ══ -->
  <div class="sp-bottom">

    <!-- Full Details -->
    <div class="sp-details-card" style="margin-top: -72px;">
      <div class="sp-section-hd"><i class="bi bi-list-check"></i> Full Details</div>

      <!-- Description -->
      <% if(car.description){ %>
      <p class="sp-desc"><%= car.description %></p>
      <% } %>

      <!-- All specs table -->
      <div class="sp-detail-grid">
        <% const detailRows = [
          {label:'Model Year', val:car.year, icon:'bi-calendar-check'},
          {label:'Fuel Type', val:car.fuel, icon:'bi-fuel-pump'},
          {label:'Transmission', val:car.transmission, icon:'bi-gear-wide-connected'},
          {label:'KM Driven', val:car.mileage ? car.mileage.toLocaleString('en-IN')+' km' : null, icon:'bi-speedometer2'},
          {label:'Ownership', val:car.ownership, icon:'bi-person-badge'},
          {label:'Color', val:car.color, icon:'bi-palette'},
          {label:'Seats', val:car.seats ? car.seats+' Seater' : null, icon:'bi-people'},
          {label:'Engine', val:car.engineCC ? car.engineCC+' cc' : null, icon:'bi-cpu'},
          {label:'Power', val:car.powerBHP ? car.powerBHP+' bhp' : null, icon:'bi-lightning'},
          {label:'Registration City', val:car.registrationCity, icon:'bi-building'},
          {label:'Registration Year', val:car.registrationYear, icon:'bi-calendar3'},
          {label:'Insurance', val:car.insuranceStatus, icon:'bi-shield-check'},
          {label:'Insurance Valid Till', val:car.insuranceValidTill, icon:'bi-calendar-event'},
          {label:'Condition', val:car.condition, icon:'bi-stars'},
          {label:'Accident History', val:car.accidentHistory==='true'||car.accidentHistory===true ? 'Yes (Declared)' : (car.accidentHistory!==undefined?'No Accident':null), icon:'bi-car-front'},
          {label:'Service History', val:car.serviceHistory, icon:'bi-journal-check'},
          {label:'Availability', val:car.availability, icon:'bi-calendar-range'},
          {label:'City', val:car.city, icon:'bi-geo-alt'},
          {label:'State', val:car.state, icon:'bi-map'},
        ]; %>
        <% detailRows.forEach(row=>{ if(!row.val) return; %>
        <div class="sp-drow">
          <span class="sp-drow-lbl"><i class="bi <%= row.icon %>"></i> <%= row.label %></span>
          <span class="sp-drow-val"><%= row.val %></span>
        </div>
        <% }); %>
      </div>

      <!-- Features -->
      <% const FEATURE_MAP = {
        ac:'Air Conditioning',powerSteering:'Power Steering',powerWindows:'Power Windows',
        abs:'ABS Brakes',airbags:'Airbags',sunroof:'Sunroof',touchscreen:'Touchscreen',
        reverseCamera:'Reverse Camera',alloyWheels:'Alloy Wheels',bluetooth:'Bluetooth',
        cruiseControl:'Cruise Control',keylessEntry:'Keyless Entry'
      }; %>
      <% const ICON_MAP = {
        ac:'bi-wind',powerSteering:'bi-arrows-move',powerWindows:'bi-window',
        abs:'bi-shield-fill',airbags:'bi-balloon-fill',sunroof:'bi-brightness-high',
        touchscreen:'bi-tablet',reverseCamera:'bi-camera-video',alloyWheels:'bi-circle',
        bluetooth:'bi-bluetooth',cruiseControl:'bi-speedometer',keylessEntry:'bi-key'
      }; %>
      <% if(car.features && typeof car.features === 'object'){ %>
        <% const activeFeatures = Object.keys(FEATURE_MAP).filter(k=>car.features[k]==='true'||car.features[k]===true); %>
        <% if(activeFeatures.length > 0){ %>
        <div class="sp-features-hd"><i class="bi bi-grid-3x3-gap"></i> Features</div>
        <div class="sp-features">
          <% activeFeatures.forEach(k=>{ %>
          <span class="sp-feature"><i class="bi <%= ICON_MAP[k]||'bi-check' %>"></i> <%= FEATURE_MAP[k] %></span>
          <% }); %>
        </div>
        <% } %>
      <% } %>
    </div>

    <!-- Reviews -->
    <div class="sp-reviews-card">
      <div class="sp-reviews-hd">
        <div class="sp-reviews-hd-l">
          <span class="sp-rev-title">Reviews</span>
          <span class="sp-rev-count"><%= car.reviews.length %></span>
          <% if(avgRating){ %><span class="sp-avg"><i class="bi bi-star-fill"></i> <%= avgRating %></span><% } %>
        </div>
        <% if(!currentUser){ %><a href="/login" class="sp-login-link"><i class="bi bi-box-arrow-in-right"></i> Login to review</a><% } %>
      </div>

      <div class="sp-reviews-list">
        <% if(car.reviews.length === 0){ %>
          <div class="sp-no-reviews">
            <i class="bi bi-chat-square-dots"></i>
            <p>No reviews yet — be first!</p>
          </div>
        <% } else { %>
          <% for(let review of car.reviews){ %>
          <div class="sp-review">
            <div class="sp-review-top">
              <div class="sp-rev-av"><%= review.author ? review.author.username.charAt(0).toUpperCase() : 'U' %></div>
              <div class="sp-rev-meta">
                <span class="sp-rev-author"><%= review.author ? review.author.username : 'User' %></span>
                <span class="sp-rev-stars">
                  <% for(let i=1;i<=5;i++){ %><i class="bi bi-star<%= i<=review.rating?'-fill':'' %>"></i><% } %>
                </span>
              </div>
              <% if(currentUser && review.author && review.author._id && review.author._id.toString()===currentUser._id.toString()){ %>
              <form action="/cars/<%= car._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" style="margin-left:auto">
                <button class="sp-rev-del" title="Delete"><i class="bi bi-trash3"></i></button>
              </form>
              <% } %>
            </div>
            <p class="sp-rev-comment"><%= review.comment %></p>
          </div>
          <% } %>
        <% } %>
      </div>

      <% if(currentUser){ %>
      <div class="sp-review-form" style="margin-top: 183px;">
        <form action="/cars/<%= car._id %>/reviews" method="POST">
          <div class="sp-review-row">
            <div class="sp-sel-wrap">
              <select name="review[rating]" class="sp-sel" required>
                <option value="5">5 ★</option>
                <option value="4">4 ★</option>
                <option value="3">3 ★</option>
                <option value="2">2 ★</option>
                <option value="1">1 ★</option>
              </select>
              <i class="bi bi-chevron-down sp-sel-icon"></i>
            </div>
            <input type="text" name="review[comment]" class="sp-rev-input" placeholder="Share your experience…" required maxlength="300" />
            <button type="submit" class="sp-rev-submit"><i class="bi bi-send-fill"></i></button>
          </div>
        </form>
      </div>
      <% } %>
    </div>
  </div>
</div>

<!-- ══ LIGHTBOX ══ -->
<div class="sp-lightbox" id="spLightbox">
  <button class="sp-lb-close" id="spLbClose">&times;</button>
  <button class="sp-lb-nav sp-lb-l" id="spLbPrev"><i class="bi bi-chevron-left"></i></button>
  <img src="" alt="Full image" class="sp-lb-img" id="spLbImg" />
  <button class="sp-lb-nav sp-lb-r" id="spLbNext"><i class="bi bi-chevron-right"></i></button>
</div>

<!-- ══ DELETE MODAL ══ -->
<div class="sp-modal-bg" id="spDeleteModal">
  <div class="sp-modal">
    <div class="sp-modal-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
    <h3>Delete this listing?</h3>
    <p>This action is permanent and cannot be undone.</p>
    <div class="sp-modal-btns">
      <button class="sp-modal-cancel" id="spDeleteCancel">Cancel</button>
      <button class="sp-modal-confirm" id="spDeleteConfirm"><i class="bi bi-trash3"></i> Delete</button>
    </div>
  </div>
</div>

<script>
(function(){
  /* ── Gallery ── */
  const imgs = [...document.querySelectorAll('.sp-img')];
  const thumbs = [...document.querySelectorAll('.sp-thumb')];
  const counter = document.getElementById('spCounter');
  const gallMain = document.getElementById('spGalleryMain');
  let cur = 0;

  function goTo(i){
    imgs.forEach(x=>x.classList.remove('sp-img-active'));
    thumbs.forEach(x=>x.classList.remove('sp-thumb-active'));
    cur = ((i%imgs.length)+imgs.length)%imgs.length;
    if(imgs[cur]) imgs[cur].classList.add('sp-img-active');
    if(thumbs[cur]){ thumbs[cur].classList.add('sp-thumb-active'); thumbs[cur].scrollIntoView({behavior:'smooth',block:'nearest',inline:'center'}); }
    if(counter) counter.textContent = (cur+1)+' / '+imgs.length;
    if(lbOpen && document.getElementById('spLbImg')) document.getElementById('spLbImg').src = imgs[cur].src;
  }
  document.getElementById('spPrev')?.addEventListener('click',e=>{e.stopPropagation();goTo(cur-1)});
  document.getElementById('spNext')?.addEventListener('click',e=>{e.stopPropagation();goTo(cur+1)});
  thumbs.forEach((t,i)=>t.addEventListener('click',()=>goTo(i)));

  /* Lightbox */
  let lbOpen = false;
  const lb = document.getElementById('spLightbox');
  const lbImg = document.getElementById('spLbImg');
  const openLB = () => { if(!imgs.length)return; lbImg.src=imgs[cur].src; lb.classList.add('active'); lbOpen=true; document.body.style.overflow='hidden'; };
  const closeLB = () => { lb.classList.remove('active'); lbOpen=false; lbImg.classList.remove('zoomed'); document.body.style.overflow=''; };
  if(gallMain) gallMain.addEventListener('click',e=>{ if(e.target.classList.contains('sp-img')) openLB(); });
  document.getElementById('spLbClose')?.addEventListener('click',closeLB);
  lb?.addEventListener('click',e=>{ if(e.target===lb) closeLB(); });
  document.getElementById('spLbPrev')?.addEventListener('click',e=>{e.stopPropagation();goTo(cur-1)});
  document.getElementById('spLbNext')?.addEventListener('click',e=>{e.stopPropagation();goTo(cur+1)});
  lbImg?.addEventListener('click',e=>{ e.stopPropagation(); lbImg.classList.toggle('zoomed'); });
  document.addEventListener('keydown',e=>{ if(!lbOpen) return; if(e.key==='Escape') closeLB(); if(e.key==='ArrowLeft') goTo(cur-1); if(e.key==='ArrowRight') goTo(cur+1); });

  /* Swipe */
  if(gallMain && imgs.length>1){ let sx=0; gallMain.addEventListener('touchstart',e=>{sx=e.touches[0].clientX},{passive:true}); gallMain.addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-sx; if(Math.abs(dx)>40) goTo(dx<0?cur+1:cur-1);}); }

  /* Delete modal */
  const modal = document.getElementById('spDeleteModal');
  let pendingForm = null;
  window.spConfirmDelete = function(){ modal.classList.add('active'); return false; };
  document.getElementById('spDeleteConfirm')?.addEventListener('click',()=>{ modal.classList.remove('active'); document.querySelector('[onsubmit]')?.submit(); });
  document.getElementById('spDeleteCancel')?.addEventListener('click',()=>modal.classList.remove('active'));
  modal?.addEventListener('click',e=>{ if(e.target===modal) modal.classList.remove('active'); });

  /* Auto-dismiss flash */
  document.querySelectorAll('.sp-flash').forEach(el=>setTimeout(()=>el?.remove(),5000));
})();
</script>

<style>
:root{
  --blue:#2563eb;--blue-dk:#1d4ed8;--blue-lt:#eff6ff;--blue-100:#dbeafe;
  --ink:#0a1628;--muted:#64748b;--border:#e2e8f0;--surface:#f1f5fb;
  --white:#ffffff;--green:#16a34a;--red:#dc2626;--amber:#f59e0b;
  --font:'DM Sans',sans-serif;--font-hd:'Syne',sans-serif;
  --r:10px;--r-lg:16px;
  --shadow:0 2px 12px rgba(10,22,40,.08);
  --shadow-lg:0 8px 32px rgba(10,22,40,.14);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

.sp-wrap{max-width:1160px;margin:0 auto;padding:24px 20px 64px;font-family:var(--font);animation:spFadeUp .4s ease both}
@keyframes spFadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}

/* Flash */
.sp-flash{display:flex;align-items:center;gap:9px;max-width:1160px;margin:0 auto 16px;padding:11px 16px;border-radius:var(--r);font-size:.84rem;font-weight:500;font-family:var(--font)}
.sp-flash-ok{background:#f0fdf4;border:1px solid #bbf7d0;color:#15803d}
.sp-flash-err{background:#fef2f2;border:1px solid #fecaca;color:var(--red)}
.sp-flash-x{margin-left:auto;background:none;border:none;font-size:1.1rem;cursor:pointer;color:inherit;opacity:.6;line-height:1}
.sp-flash-x:hover{opacity:1}

/* Breadcrumb */
.sp-crumbs{display:flex;align-items:center;gap:6px;font-size:.74rem;color:var(--muted);margin-bottom:18px;flex-wrap:wrap}
.sp-crumbs a{color:var(--muted);text-decoration:none;transition:color .15s}
.sp-crumbs a:hover{color:var(--blue)}
.sp-crumb-cur{color:var(--ink);font-weight:600}

/* ── TOP GRID ── */
.sp-top{display:grid;grid-template-columns:1fr 350px;gap:22px;align-items:start}

/* Gallery */
.sp-gallery{border-radius:var(--r-lg);overflow:hidden;background:#071022;box-shadow:var(--shadow-lg)}
.sp-gallery-main{position:relative;aspect-ratio:16/10;overflow:hidden;background:#040d1c;cursor:zoom-in}
.sp-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .3s;pointer-events:none}
.sp-img-active{opacity:1;pointer-events:auto}
.sp-no-img{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:rgba(255,255,255,.18);font-size:.8rem}
.sp-no-img i{font-size:3rem}

.sp-gallery-badges{position:absolute;top:12px;left:12px;display:flex;gap:6px;z-index:3}
.sp-badge{font-size:.64rem;font-weight:700;padding:4px 11px;border-radius:20px;letter-spacing:.07em;text-transform:uppercase}
.sp-badge-sale{background:var(--blue);color:#fff}
.sp-badge-urgent{background:var(--red);color:#fff}
.sp-badge-year{background:rgba(0,0,0,.55);color:rgba(255,255,255,.8);backdrop-filter:blur(6px)}
.sp-counter{position:absolute;bottom:12px;right:12px;z-index:3;background:rgba(0,0,0,.5);color:#fff;font-size:.68rem;font-weight:600;padding:3px 10px;border-radius:20px;backdrop-filter:blur(4px)}

.sp-nav{position:absolute;top:50%;transform:translateY(-50%);z-index:4;width:36px;height:36px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.22);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:.84rem;transition:all .18s}
.sp-nav:hover{background:rgba(37,99,235,.6);border-color:rgba(37,99,235,.7);transform:translateY(-50%) scale(1.08)}
.sp-nav-l{left:12px}.sp-nav-r{right:12px}

.sp-thumbs{display:flex;gap:6px;padding:8px 10px;background:rgba(4,13,28,.9);border-top:1px solid rgba(255,255,255,.07);overflow-x:auto;scrollbar-width:none}
.sp-thumbs::-webkit-scrollbar{display:none}
.sp-thumb{flex-shrink:0;width:62px;height:46px;border-radius:6px;overflow:hidden;border:1.5px solid transparent;cursor:pointer;opacity:.5;padding:0;background:none;transition:all .2s}
