  { name: "Audi", svg: `<svg viewBox="0 0 160 60" fill="none"><circle cx="22" cy="30" r="18" stroke="currentColor" stroke-width="4"/><circle cx="52" cy="30" r="18" stroke="currentColor" stroke-width="4"/><circle cx="82" cy="30" r="18" stroke="currentColor" stroke-width="4"/><circle cx="112" cy="30" r="18" stroke="currentColor" stroke-width="4"/></svg>` },
  { name: "Volkswagen", svg: `<svg viewBox="0 0 100 100" fill="none"><circle cx="50" cy="50" r="46" stroke="currentColor" stroke-width="4"/><line x1="22" y1="50" x2="78" y2="50" stroke="currentColor" stroke-width="3"/><path d="M34 25 L50 58 L66 25" stroke="currentColor" stroke-width="3.5" fill="none" stroke-linejoin="round"/><path d="M28 58 L50 84 L72 58" stroke="currentColor" stroke-width="3.5" fill="none" stroke-linejoin="round"/></svg>` },
  { name: "Nissan", svg: `<svg viewBox="0 0 160 80" fill="none"><ellipse cx="80" cy="40" rx="74" ry="36" stroke="currentColor" stroke-width="4"/><line x1="6" y1="40" x2="154" y2="40" stroke="currentColor" stroke-width="4"/><rect x="35" y="28" width="90" height="24" fill="none" stroke="currentColor" stroke-width="3"/><text x="80" y="46" text-anchor="middle" font-size="14" font-weight="bold" fill="currentColor" font-family="sans-serif" letter-spacing="2">NISSAN</text></svg>` },
