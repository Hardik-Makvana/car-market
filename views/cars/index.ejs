<!-- ═══════════════ CARS LISTING ═══════════════ -->
<section class="listing-section">
  <div class="listing-section-head">
    <div>
      <div class="section-eyebrow"><i class="bi bi-car-front"></i> Browse Inventory</div>
      <h2 class="section-title">Available Cars</h2>
    </div>
  </div>

  <div class="listing-layout">
    <!-- FILTER SIDEBAR -->
    <aside class="filter-sidebar" id="filterSidebar" style="height: 470px;">
      <div class="filter-sidebar-title"><i class="bi bi-funnel-fill"></i> Filters</div>

      <form id="filterForm" method="GET" action="/cars">

        <div class="filter-group">
          <div class="filter-group-label"><i class="bi bi-currency-rupee"></i> Price Range (₹)</div>
          <div class="range-inputs">
            <input type="number" name="minPrice" placeholder="Min" value="<%= filters.minPrice || '' %>" />
            <span class="range-separator">—</span>
            <input type="number" name="maxPrice" placeholder="Max" value="<%= filters.maxPrice || '' %>" />
          </div>
        </div>

        <div class="filter-group">
          <div class="filter-group-label"><i class="bi bi-calendar3"></i> Year Range</div>
          <div class="range-inputs">
            <input type="number" name="minYear" placeholder="From" value="<%= filters.minYear || '' %>" />
            <span class="range-separator">—</span>
            <input type="number" name="maxYear" placeholder="To" value="<%= filters.maxYear || '' %>" />
          </div>
        </div>

        <div class="filter-group">
          <div class="filter-group-label"><i class="bi bi-fuel-pump"></i> Fuel Type</div>
          <div class="filter-select-wrap">
            <select name="fuel" class="filter-select">
              <option value="">All Fuel Types</option>
              <% if (typeof filterOptions !== 'undefined' && filterOptions.fuels) { %>
                <% filterOptions.fuels.forEach(f => { %>
                  <option value="<%= f %>" <%= filters.fuel === f ? 'selected' : '' %>><%= f %></option>
                <% }); %>
              <% } %>
            </select>
            <i class="bi bi-chevron-down filter-select-icon"></i>
          </div>
        </div>

        <div class="filter-group">
          <div class="filter-group-label"><i class="bi bi-gear"></i> Transmission</div>
          <div class="filter-select-wrap">
            <select name="transmission" class="filter-select">
              <option value="">All Types</option>
              <% if (typeof filterOptions !== 'undefined' && filterOptions.transmissions) { %>
                <% filterOptions.transmissions.forEach(t => { %>
                  <option value="<%= t %>" <%= filters.transmission === t ? 'selected' : '' %>><%= t %></option>
                <% }); %>
              <% } %>
            </select>
            <i class="bi bi-chevron-down filter-select-icon"></i>
          </div>
        </div>

        <div class="filter-group">
          <div class="filter-group-label"><i class="bi bi-geo-alt"></i> City</div>
          <div class="filter-select-wrap">
            <select name="city" class="filter-select">
              <option value="">All Cities</option>
              <% if (typeof filterOptions !== 'undefined' && filterOptions.cities) { %>
                <% filterOptions.cities.forEach(c => { %>
                  <option value="<%= c %>" <%= filters.city === c ? 'selected' : '' %>><%= c %></option>
                <% }); %>
              <% } %>
            </select>
            <i class="bi bi-chevron-down filter-select-icon"></i>
          </div>
        </div>

        <div class="filter-group">
          <div class="filter-group-label"><i class="bi bi-map"></i> State</div>
          <div class="filter-select-wrap">
            <select name="state" class="filter-select">
              <option value="">All States</option>
              <% if (typeof filterOptions !== 'undefined' && filterOptions.states) { %>
                <% filterOptions.states.forEach(s => { %>
                  <option value="<%= s %>" <%= filters.state === s ? 'selected' : '' %>><%= s %></option>
                <% }); %>
              <% } %>
            </select>
            <i class="bi bi-chevron-down filter-select-icon"></i>
          </div>
        </div>

        <% if (filters.search) { %>
          <input type="hidden" name="search" value="<%= filters.search %>" />
        <% } %>

        <div class="filter-actions">
          <button type="submit" class="filter-btn filter-btn-primary"><i class="bi bi-search"></i> Apply Filters</button>
          <a href="/cars" class="filter-btn filter-btn-secondary"><i class="bi bi-arrow-clockwise"></i> Reset</a>
        </div>

        <div class="filter-results-count">
          <strong><%= cars.length %></strong> car<%= cars.length !== 1 ? 's' : '' %> found
        </div>
      </form>
    </aside>

    <!-- CARS GRID -->
    <div class="cars-grid-container">

      <!-- Mobile filter toggle -->
      <button class="filter-toggle-btn" id="filterToggleBtn">
        <i class="bi bi-funnel"></i> Filters
        <% if (cars.length > 0) { %><span class="filter-badge"><%= cars.length %></span><% } %>
      </button>

      <!-- Sort toolbar -->
      <div class="cars-toolbar">
        <!-- <div class="cars-count-tag">
          <strong><%= cars.length %></strong> car<%= cars.length !== 1 ? 's' : '' %> available
        </div> -->
        <form method="GET" action="/cars" class="sort-wrap" id="sortForm">
          <!-- Carry existing filters into sort form -->
          <% if (filters.search) { %><input type="hidden" name="search" value="<%= filters.search %>"/><% } %>
          <% if (filters.minPrice) { %><input type="hidden" name="minPrice" value="<%= filters.minPrice %>"/><% } %>
          <% if (filters.maxPrice) { %><input type="hidden" name="maxPrice" value="<%= filters.maxPrice %>"/><% } %>
          <% if (filters.minYear) { %><input type="hidden" name="minYear" value="<%= filters.minYear %>"/><% } %>
          <% if (filters.maxYear) { %><input type="hidden" name="maxYear" value="<%= filters.maxYear %>"/><% } %>
          <% if (filters.fuel) { %><input type="hidden" name="fuel" value="<%= filters.fuel %>"/><% } %>
          <% if (filters.transmission) { %><input type="hidden" name="transmission" value="<%= filters.transmission %>"/><% } %>
          <% if (filters.city) { %><input type="hidden" name="city" value="<%= filters.city %>"/><% } %>
          <% if (filters.state) { %><input type="hidden" name="state" value="<%= filters.state %>"/><% } %>
          <!-- <span class="sort-label">Sort by</span>
          <select name="sort" class="sort-select" onchange="document.getElementById('sortForm').submit()">
            <option value="newest" <%= (filters.sort||'newest')==='newest' ? 'selected':'' %>>Newest First</option>
            <option value="price-asc" <%= filters.sort==='price-asc' ? 'selected':'' %>>Price: Low → High</option>
            <option value="price-desc" <%= filters.sort==='price-desc' ? 'selected':'' %>>Price: High → Low</option>
            <option value="year-desc" <%= filters.sort==='year-desc' ? 'selected':'' %>>Year: Newest</option>
            <option value="km-asc" <%= filters.sort==='km-asc' ? 'selected':'' %>>KM: Lowest</option>
          </select> -->
        </form>
      </div>

      <!-- Cars Grid -->
      <div class="cars-grid">
        <% if (cars.length === 0) { %>
          <div class="no-cars">
            <i class="bi bi-inbox"></i>
            <p>No cars found matching your filters.</p>
            <a href="/cars">Clear all filters</a>
          </div>
        <% } else { %>
          <% for (let car of cars) { %>
            <%
              const cardImages = (car.images && car.images.length
                ? car.images
                : (car.image && car.image !== '' ? [car.image] : []));
              const cardImgSrc = cardImages.length
                ? cardImages[0]
                : 'https://via.placeholder.com/400x250?text=No+Image';
              const isEV = car.fuel === 'Electric';
            %>
            <div class="car-card">
              <!-- Image -->
              <div class="car-card-img-wrap">
                <img src="<%= cardImgSrc %>" class="car-card-img" alt="<%= car.carName %>" loading="lazy"/>
                <div class="car-card-badges">
                  <span class="cc-badge cc-badge-sale">For Sale</span>
                  <% if (car.urgentSale) { %>
                    <span class="cc-badge cc-badge-urgent"><i class="bi bi-lightning-charge-fill"></i> Urgent</span>
                  <% } %>
                  <% if (isEV) { %>
                    <span class="cc-badge cc-badge-ev"><i class="bi bi-lightning"></i> EV</span>
                  <% } %>
                </div>
                <!-- Image count badge (if multiple images) -->
                <% if (cardImages.length > 1) { %>
                  <span class="car-img-count"><i class="bi bi-images"></i> <%= cardImages.length %></span>
                <% } %>
              </div>

              <!-- Body -->
              <div class="car-card-body">
                <div class="car-card-title" title="<%= car.carName %>"><%= car.carName %></div>

                <div class="car-card-price-row">
                  <span class="car-card-price">
                    <%
                      const p = car.price;
                      let priceStr = '';
                      if (p >= 10000000) priceStr = '₹ ' + (p/10000000).toFixed(1) + ' Cr';
                      else if (p >= 100000) priceStr = '₹ ' + (p/100000).toFixed(1) + ' L';
                      else priceStr = '₹ ' + p.toLocaleString('en-IN');
                    %>
                    <%= priceStr %>
                  </span>
                  <% if (car.negotiable) { %>
                    <span class="car-card-neg"><i class="bi bi-check2-circle"></i> Negotiable</span>
                  <% } %>
                </div>

                <div class="car-card-location">
                  <i class="bi bi-geo-alt-fill"></i>
                  <span><%= car.city %><% if (car.state) { %>, <%= car.state %><% } %></span>
                </div>

                <div class="car-card-specs">
                  <% if (car.year) { %>
                    <span class="spec-pill"><i class="bi bi-calendar3"></i> <%= car.year %></span>
                  <% } %>
                  <% if (car.fuel) { %>
                    <span class="spec-pill"><i class="bi bi-fuel-pump"></i> <%= car.fuel %></span>
                  <% } %>
                  <% if (car.transmission) { %>
                    <span class="spec-pill"><i class="bi bi-gear"></i> <%= car.transmission %></span>
                  <% } %>
                  <% if (car.ownership) { %>
                    <span class="spec-pill"><i class="bi bi-person-badge"></i> <%= car.ownership %></span>
                  <% } %>
                </div>

                <div class="car-card-divider"></div>

                <!-- CTA Row -->
                <div class="car-card-cta" style="margin-top: 7px;">
                  <a href="/cars/<%= car._id %>" class="car-card-btn-view">
                    <i class="bi bi-eye-fill"></i> View Details
                  </a>
                  <% if (car.dealerPhone) { %>
                    <a href="tel:<%= car.dealerPhone %>" class="car-card-btn-call" title="Call Seller">
                      <i class="bi bi-telephone-fill"></i>
                    </a>
                    <a href="https://wa.me/<%= car.dealerPhone.replace(/[^0-9]/g,'') %>?text=Hi%2C+I'm+interested+in+your+<%= encodeURIComponent(car.carName) %>+on+RideHub."
                       target="_blank" rel="noopener" class="car-card-btn-wa" title="WhatsApp Seller">
                      <i class="bi bi-whatsapp"></i>
                    </a>
                  <% } %>
                </div>
              </div>

              <!-- Footer strip -->
              <div class="car-card-footer">
                <% if (car.mileage) { %>
                  <span><i class="bi bi-speedometer2"></i> <%= car.mileage.toLocaleString('en-IN') %> km</span>
                <% } %>
                <% if (car.color) { %>
                  <span><i class="bi bi-palette"></i> <%= car.color %></span>
                <% } %>
                <% if (car.condition) { %>
                  <span><i class="bi bi-stars"></i> <%= car.condition %></span>
                <% } %>
              </div>
            </div>
          <% } %>
        <% } %>
      </div>
    </div>
  </div>
</section>

